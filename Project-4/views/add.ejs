<%- include('layouts/header.ejs') %>

<!-- content -->

<main class="py-12">
  <div class="container mx-auto px-6">
    <div class="max-w-2xl mx-auto">
      <div
        class="bg-white border border-sand rounded-sm shadow-sm overflow-hidden"
      >
        <div class="ledger-edge h-3 bg-forest"></div>
        <div class="px-8 pt-6 pb-2 flex items-center justify-between">
          <div>
            <p
              class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-1"
            >
              New Entry
            </p>
            <h1 class="font-display text-2xl font-semibold text-ink">
              Add New Contact
            </h1>
          </div>
          <span
            class="w-10 h-10 rounded-sm bg-forest/10 text-forest flex items-center justify-center"
          >
            <i class="fa fa-user-plus"></i>
          </span>
        </div>

        <form
          action="/add-contact"
          method="post"
          class="px-8 pb-8 pt-4 space-y-5"
        >
          <div>
            <label
              for="first_name"
              class="block text-sm font-medium text-ink mb-1"
              >First Name</label
            >
            <input
              type="text"
              name="first_name"
              id="first_name"
              class="w-full rounded-sm border border-sand bg-paper px-4 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-forest/40 focus:border-forest transition"
            />
          </div>

          <div>
            <label
              for="last_name"
              class="block text-sm font-medium text-ink mb-1"
              >Last Name</label
            >
            <input
              type="text"
              name="last_name"
              id="last_name"
              class="w-full rounded-sm border border-sand bg-paper px-4 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-forest/40 focus:border-forest transition"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-ink mb-1"
              >Email</label
            >
            <input
              type="text"
              name="email"
              id="email"
              class="w-full rounded-sm border border-sand bg-paper px-4 py-2.5 font-mono text-sm text-ink focus:outline-none focus:ring-2 focus:ring-forest/40 focus:border-forest transition"
            />
          </div>

          <div>
            <label for="phone" class="block text-sm font-medium text-ink mb-1"
              >Phone</label
            >
            <input
              type="text"
              name="phone"
              id="phone"
              class="w-full rounded-sm border border-sand bg-paper px-4 py-2.5 font-mono text-sm text-ink focus:outline-none focus:ring-2 focus:ring-forest/40 focus:border-forest transition"
            />
          </div>

          <div>
            <label for="address" class="block text-sm font-medium text-ink mb-1"
              >Address</label
            >
            <textarea
              name="address"
              id="address"
              rows="3"
              class="w-full rounded-sm border border-sand bg-paper px-4 py-2.5 text-ink focus:outline-none focus:ring-2 focus:ring-forest/40 focus:border-forest transition"
            ></textarea>
          </div>

          <hr class="border-sand" />

          <div class="flex items-center gap-3 pt-1">
            <button
              type="submit"
              class="bg-forest hover:bg-forestdark text-paper font-medium px-6 py-2.5 rounded-sm transition-colors"
            >
              Save
            </button>
            <a
              href="/contact"
              class="text-muted hover:text-ink font-medium px-4 py-2.5 transition-colors"
              >Cancel</a
            >
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('layouts/footer.ejs') %>
