<%- include('layouts/header.ejs') %>

<main class="py-12">
    <div class="container mx-auto px-6">

        <!-- Heading -->
        <div class="flex items-end justify-between flex-wrap gap-4 mb-8">
            <div>
                <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-1">
                    Directory
                </p>
                <h1 class="font-display text-4xl font-semibold text-ink">
                    All Contacts
                </h1>
            </div>

            <a href="/add-contact"
                class="inline-flex items-center gap-2 bg-forest hover:bg-forestdark text-paper font-medium px-5 py-2.5 rounded-sm transition-colors">
                <i class="fa fa-plus-circle"></i>
                Add New
            </a>
        </div>

        <div class="bg-white border border-sand rounded-sm shadow-sm overflow-hidden">

            <!-- Table Header -->
            <div
                class="hidden md:grid grid-cols-[3rem_1fr_1fr_1fr_9rem] gap-4 px-6 py-3 bg-sand/40 font-mono text-[11px] uppercase tracking-wider text-muted border-b border-sand">
                <span>#</span>
                <span>Name</span>
                <span>Email</span>
                <span>Phone</span>
                <span class="text-right">Actions</span>
            </div>

            <% let srno = pagingCounter; %>

            <% if(contacts.length===0){ %>

                <div class="px-6 py-16 text-center">
                    <p class="font-display text-xl text-ink mb-1">
                        The directory is empty
                    </p>

                    <p class="text-muted text-sm">
                        Add your first contact to get started.
                    </p>
                </div>

            <% } %>

            <% contacts.forEach(contact=>{ %>

                <div
                    class="group grid grid-cols-[3rem_1fr] md:grid-cols-[3rem_1fr_1fr_1fr_9rem] gap-2 md:gap-4 items-center px-6 py-4 border-b border-sand last:border-b-0 hover:bg-sand/20 transition-colors">

                    <!-- Sr No -->
                    <div class="flex justify-center font-medium">
                        <%= srno++ %>
                    </div>

                    <!-- Name -->
                    <div>
                        <p class="font-display text-lg text-ink">
                            <%= contact.first_name %>
                                <%= contact.last_name %>
                        </p>

                        <p class="md:hidden font-mono text-xs text-muted mt-1">
                            <%= contact.email %> • <%= contact.phone %>
                        </p>
                    </div>

                    <!-- Email -->
                    <div class="hidden md:block font-mono text-sm text-muted truncate">
                        <%= contact.email %>
                    </div>

                    <!-- Phone -->
                    <div class="hidden md:block font-mono text-sm text-muted">
                        <%= contact.phone %>
                    </div>

                    <!-- Actions -->
                    <div class="flex md:justify-end gap-2">

                        <a href="/show-contact/<%= contact._id %>"
                            class="w-8 h-8 rounded border border-sand flex items-center justify-center hover:text-green-700 hover:border-green-700">
                            <i class="fa fa-eye"></i>
                        </a>

                        <a href="/update-contact/<%= contact._id %>"
                            class="w-8 h-8 rounded border border-sand flex items-center justify-center hover:text-yellow-600 hover:border-yellow-600">
                            <i class="fa fa-edit"></i>
                        </a>

                        <a href="/delete-contact/<%= contact._id %>"
                            onclick="return confirm('Are you sure you want to delete this contact?')"
                            class="w-8 h-8 rounded border border-sand flex items-center justify-center hover:text-red-600 hover:border-red-600">
                            <i class="fa fa-trash"></i>
                        </a>

                    </div>

                </div>

            <% }) %>

        </div>

        <!-- Pagination -->
        <% if(totalPages > 1){ %>

        <div class="flex flex-col md:flex-row justify-between items-center mt-8 gap-4">

            <!-- Showing Records -->
            <div class="text-sm text-gray-600">
                Showing
                <strong><%= pagingCounter %></strong>
                -
                <strong><%= Math.min(pagingCounter + contacts.length - 1, totalDocs) %></strong>
                of
                <strong><%= totalDocs %></strong>
                Contacts
            </div>

            <!-- Pagination Links -->
            <div class="flex items-center gap-2 flex-wrap">

                <% if(hasPrevPage){ %>

                    <a href="/contact?page=<%= prevPage %>&limit=<%= limit %>"
                        class="px-4 py-2 border rounded hover:bg-gray-100">
                        Previous
                    </a>

                <% } %>

                <% for(let i=1;i<=totalPages;i++){ %>

                    <% if(i===page){ %>

                        <span class="px-4 py-2 rounded bg-green-700 text-white">
                            <%= i %>
                        </span>

                    <% }else{ %>

                        <a href="/contact?page=<%= i %>&limit=<%= limit %>"
                            class="px-4 py-2 border rounded hover:bg-gray-100">
                            <%= i %>
                        </a>

                    <% } %>

                <% } %>

                <% if(hasNextPage){ %>

                    <a href="/contact?page=<%= nextPage %>&limit=<%= limit %>"
                        class="px-4 py-2 border rounded hover:bg-gray-100">
                        Next
                    </a>

                <% } %>

            </div>

        </div>

        <% } %>

    </div>
</main>

<%- include('layouts/footer.ejs') %>