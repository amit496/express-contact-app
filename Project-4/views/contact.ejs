<%- include('layouts/header.ejs') %>

<!-- content -->

<main class="py-12">
  <div class="container mx-auto px-6">

    <div class="flex items-end justify-between flex-wrap gap-4 mb-8">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-1">
          Directory
        </p>
        <h1 class="font-display text-4xl font-semibold text-ink">
          All Contacts
        </h1>
      </div>
      <a
        href="/add-contact"
        class="inline-flex items-center gap-2 bg-forest hover:bg-forestdark text-paper font-medium px-5 py-2.5 rounded-sm transition-colors"
      >
        <i class="fa fa-plus-circle"></i> Add New
      </a>
    </div>

    <div class="bg-white border border-sand rounded-sm shadow-sm overflow-hidden">

      <!-- column headings -->
      <div
        class="hidden md:grid grid-cols-[3rem_1fr_1fr_1fr_9rem] gap-4 px-6 py-3 bg-sand/40 font-mono text-[11px] uppercase tracking-wider text-muted border-b border-sand"
      >
        <span>#</span>
        <span>Name</span>
        <span>Email</span>
        <span>Phone</span>
        <span class="text-right">Actions</span>
      </div>

      <% if (contacts.length === 0) { %>
      <div class="px-6 py-16 text-center">
        <p class="font-display text-xl text-ink mb-1">The directory is empty</p>
        <p class="text-muted text-sm">Add your first contact to get started.</p>
      </div>
      <% } %>

      <%
      const tabColors = ['bg-forest', 'bg-gold', 'bg-rust', 'bg-muted'];
      contacts.forEach((contact, i) => {
      %>
      <div
        class="group grid grid-cols-[3rem_1fr] md:grid-cols-[3rem_1fr_1fr_1fr_9rem] gap-2 md:gap-4 items-center px-0 py-4 border-b border-sand last:border-b-0 hover:bg-sand/20 transition-colors"
      >
        <!-- rolodex tab -->
        <div class="flex justify-center">
          <span
            class="<%= tabColors[i % tabColors.length] %> text-paper w-8 h-8 rounded-sm flex items-center justify-center font-mono text-xs font-medium"
          >
            <%= (contact.last_name || contact.first_name || '?').charAt(0).toUpperCase() %>
          </span>
        </div>

        <div class="md:col-span-1">
          <p class="font-display text-lg text-ink leading-tight">
            <%= contact.first_name %> <%= contact.last_name %>
          </p>
          <p class="md:hidden font-mono text-xs text-muted mt-1">
            <%= contact.email %> · <%= contact.phone %>
          </p>
        </div>

        <div class="hidden md:block font-mono text-sm text-muted truncate">
          <%= contact.email %>
        </div>

        <div class="hidden md:block font-mono text-sm text-muted">
          <%= contact.phone %>
        </div>

        <div class="flex md:justify-end gap-2 pl-14 md:pl-0">
          <a
            href="/show-contact/<%= contact._id %>"
            title="Show"
            class="w-8 h-8 rounded-sm border border-sand flex items-center justify-center text-ink hover:border-forest hover:text-forest transition-colors"
            ><i class="fa fa-eye text-sm"></i
          ></a>
          <a
            href="/update-contact/<%= contact._id %>"
            title="Edit"
            class="w-8 h-8 rounded-sm border border-sand flex items-center justify-center text-ink hover:border-gold hover:text-gold transition-colors"
            ><i class="fa fa-edit text-sm"></i
          ></a>
          <a
            href="/delete-contact/<%= contact._id %>"
            title="Delete"
            onclick="return confirm('Are you sure?')"
            class="w-8 h-8 rounded-sm border border-sand flex items-center justify-center text-ink hover:border-rust hover:text-rust transition-colors"
            ><i class="fa fa-times text-sm"></i
          ></a>
        </div>
      </div>
      <% }) %>

    </div>
  </div>
</main>

<%- include('layouts/footer.ejs') %>
